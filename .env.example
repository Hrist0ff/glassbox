# Copy to .env.local and fill in.
#   * Everything empty: local demo mode (bundled fixtures only, no AI calls).
#   * Only OPENAI_API_KEY: real generation without a database; nothing is saved.
#   * OPENAI_API_KEY plus all three Supabase values: generation is saved and public.

# --- Supabase -----------------------------------------------------------------
# Project URL and publishable (anon) key: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service_role) key: SERVER ONLY. Bypasses RLS; used for inserts, the
# rate-limit functions, and to key the per-visitor limit. There are no accounts.
SUPABASE_SECRET_KEY=

# --- OpenAI (server only) -------------------------------------------------------
OPENAI_API_KEY=
# Default model for all three roles. Confirm your account can use it.
OPENAI_MODEL=gpt-6-luna
# Optional per-role overrides.
OPENAI_EXTRACTOR_MODEL=
OPENAI_GENERATOR_MODEL=
OPENAI_EVALUATOR_MODEL=
# Optional: none | minimal | low | medium | high. Leave empty for models
# without reasoning-effort support.
OPENAI_REASONING_EFFORT=low
# Optional: OpenAI-compatible endpoint (read by the OpenAI SDK). The e2e tests
# point this at scripts/mock-openai.ts.
# OPENAI_BASE_URL=

# --- Generation -----------------------------------------------------------------
# live | demo. Defaults to live when OPENAI_API_KEY is set, otherwise demo.
GENERATION_MODE=
# Server deadline per request in ms (30000–290000). Must stay below the route's
# maxDuration of 300 s; default 270000.
GENERATION_DEADLINE_MS=270000
# Shared, database-backed limits (rolling one-hour window). Anyone can generate,
# so the global limit caps your OpenAI cost.
RATE_LIMIT_PER_CLIENT_PER_HOUR=5
RATE_LIMIT_GLOBAL_PER_HOUR=100
